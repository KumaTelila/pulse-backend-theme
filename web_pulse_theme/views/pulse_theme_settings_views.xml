<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pulse_theme" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pulse.theme</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="after">
                <app data-string="Theme Settings" string="Theme Settings" name="pulse_theme" logo="/web/static/img/placeholder.png" groups="base.group_system">
                    <div id="pulse_theme_settings">
                        <block title="Pulse theme" name="pulse_theme_setting_container">
                            <setting
                                id="pulse_theme_colors_setting"
                                string="Interface colors"
                                help="Default colors for the Pulse backend shell (aligned with the HTML design: primary, text, background, borders). The accent can still be changed per browser from the palette icon in the systray."
                            >
                                <div class="content-group">
                                    <div class="row mt-2">
                                        <label for="pulse_theme_primary" string="Primary accent" class="col-lg-3 o_light_label"/>
                                        <field name="pulse_theme_primary" widget="color" class="w-25"/>
                                    </div>
                                    <div class="row mt-2">
                                        <label for="pulse_theme_text" string="Main text" class="col-lg-3 o_light_label"/>
                                        <field name="pulse_theme_text" widget="color" class="w-25"/>
                                    </div>
                                    <div class="row mt-2">
                                        <label for="pulse_theme_muted" string="Muted text" class="col-lg-3 o_light_label"/>
                                        <field name="pulse_theme_muted" widget="color" class="w-25"/>
                                    </div>
                                    <div class="row mt-2">
                                        <label for="pulse_theme_on_primary" string="Button text on primary" class="col-lg-3 o_light_label"/>
                                        <field name="pulse_theme_on_primary" widget="color" class="w-25"/>
                                    </div>
                                    <div class="row mt-2">
                                        <label for="pulse_theme_on_muted" string="Button text on muted" class="col-lg-3 o_light_label"/>
                                        <field name="pulse_theme_on_muted" widget="color" class="w-25"/>
                                    </div>
                                    <div class="row mt-2">
                                        <label for="pulse_theme_canvas" string="Background" class="col-lg-3 o_light_label"/>
                                        <field name="pulse_theme_canvas" widget="color" class="w-25"/>
                                    </div>
                                    <div class="row mt-2">
                                        <label for="pulse_theme_border" string="Borders" class="col-lg-3 o_light_label"/>
                                        <field name="pulse_theme_border" widget="color" class="w-25"/>
                                    </div>
                                    <div class="row mt-3">
                                        <label for="pulse_theme_app_icon_style" string="App icons" class="col-lg-3 o_light_label"/>
                                        <field name="pulse_theme_app_icon_style" widget="radio"/>
                                    </div>
                                    <div class="mt-3 d-flex gap-2 flex-wrap align-items-center">
                                        <button
                                            name="action_pulse_theme_reset_defaults"
                                            type="object"
                                            string="Reset to default colors"
                                            class="btn btn-secondary"
                                            icon="fa-undo"
                                            confirm="Restore the default Pulse theme colors (as in the HTML design) for everyone? Users who changed only the accent via the systray palette still have that override in their browser until they reset it there."
                                        />
                                    </div>
                                </div>
                            </setting>
                        </block>
                    </div>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
